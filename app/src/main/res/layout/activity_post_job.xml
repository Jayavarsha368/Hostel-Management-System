<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/surface"
    android:fillViewport="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Back button -->
        <TextView
            android:id="@+id/backButton"
            android:text="← Back"
            android:textSize="14sp"
            android:textColor="@color/teal"
            android:paddingVertical="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="NEW OPPORTUNITY"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/accentOrange"
            android:letterSpacing="0.12"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Post a job."
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/ink"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Describe what you need clearly to attract the right talent."
            android:textSize="15sp"
            android:textColor="@color/inkSecondary"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Job Title -->
        <TextView
            android:text="Job title *"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/inkSecondary"
            android:letterSpacing="0.06"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/jobTitle"
            android:hint="e.g. Android Developer needed"
            android:inputType="textCapWords"
            android:background="@drawable/bg_input"
            android:textColor="@color/ink"
            android:textColorHint="@color/hint"
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <!-- Description -->
        <TextView
            android:text="Description *"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/inkSecondary"
            android:letterSpacing="0.06"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/jobDescription"
            android:hint="Describe the project, requirements, and deliverables…"
            android:inputType="textMultiLine"
            android:minLines="4"
            android:gravity="top|start"
            android:background="@drawable/bg_input"
            android:textColor="@color/ink"
            android:textColorHint="@color/hint"
            android:textSize="15sp"
            android:paddingTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="130dp" />

        <!-- Budget -->
        <TextView
            android:text="Budget"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/inkSecondary"
            android:letterSpacing="0.06"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/budget"
            android:hint="e.g. $500 or Negotiable"
            android:inputType="text"
            android:background="@drawable/bg_input"
            android:textColor="@color/ink"
            android:textColorHint="@color/hint"
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <!-- Required Skills -->
        <TextView
            android:text="Skills required"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/inkSecondary"
            android:letterSpacing="0.06"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/skills"
            android:hint="e.g. Kotlin, REST API, Firebase"
            android:background="@drawable/bg_input"
            android:textColor="@color/ink"
            android:textColorHint="@color/hint"
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <TextView
            android:text="Separate skills with commas"
            android:textSize="12sp"
            android:textColor="@color/muted"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Duration -->
        <TextView
            android:text="Duration"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/inkSecondary"
            android:letterSpacing="0.06"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/duration"
            android:hint="e.g. 2 weeks, 1 month"
            android:background="@drawable/bg_input"
            android:textColor="@color/ink"
            android:textColorHint="@color/hint"
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <!-- Deadline -->
        <TextView
            android:text="Deadline"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/inkSecondary"
            android:letterSpacing="0.06"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/deadline"
            android:hint="e.g. 2026-10-31"
            android:inputType="date"
            android:background="@drawable/bg_input"
            android:textColor="@color/ink"
            android:textColorHint="@color/hint"
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <!-- Publish Button -->
        <Button
            android:id="@+id/saveJob"
            android:text="Publish job  →"
            android:textAllCaps="false"
            android:textColor="@color/navy"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/bg_pill"
            android:layout_marginTop="28dp"
            android:layout_width="match_parent"
            android:layout_height="58dp" />

        <Button
            android:id="@+id/manageJobPosts"
            android:text="Manage job posts"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:background="@drawable/bg_action_card"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="54dp" />

    </LinearLayout>
</ScrollView>
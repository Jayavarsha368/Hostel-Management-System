<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/surface"
    android:fillViewport="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="60dp"
        android:paddingBottom="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Logo / Brand -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:text="●"
                android:textSize="20sp"
                android:textColor="@color/teal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="  FreelancerConnect"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/inkSecondary"
                android:letterSpacing="0.04"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:text="Choose your role."
            android:textSize="38sp"
            android:textStyle="bold"
            android:textColor="@color/ink"
            android:layout_marginTop="48dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:text="This helps us personalise your experience. You can change this later in your profile settings."
            android:textSize="15sp"
            android:textColor="@color/inkSecondary"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Freelancer Option Card -->
        <LinearLayout
            android:id="@+id/freelancerCard"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/bg_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="👨‍💻  I'm a Freelancer"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Browse jobs, apply to projects, build your portfolio and get paid."
                android:textSize="14sp"
                android:textColor="@color/inkSecondary"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/freelancerButton"
            android:text="Start as Freelancer  →"
            android:textAllCaps="false"
            android:textColor="@color/navy"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/bg_pill"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="58dp" />

        <!-- Divider with OR -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginVertical="28dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/line" />

            <TextView
                android:text="  or  "
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/line" />
        </LinearLayout>

        <!-- Client Option Card -->
        <LinearLayout
            android:id="@+id/clientCard"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/bg_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="🏢  I'm a Client"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Post jobs, hire talented freelancers and manage projects all in one place."
                android:textSize="14sp"
                android:textColor="@color/inkSecondary"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/clientButton"
            android:text="Start as Client  →"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:background="@drawable/bg_pill_outline"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="58dp" />

    </LinearLayout>
</ScrollView>
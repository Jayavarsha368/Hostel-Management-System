<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="40dp"
    android:paddingBottom="24dp"
    android:background="@color/surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/backButton"
        android:text="← Back to job"
        android:textSize="14sp"
        android:textColor="@color/teal"
        android:paddingVertical="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:text="YOUR APPLICATION"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/teal"
        android:layout_marginTop="28dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:text="Introduce yourself"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/ink"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:text="Tell the client why you are a good fit for this project."
        android:textSize="14sp"
        android:textColor="@color/inkSecondary"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <EditText
        android:id="@+id/coverLetter"
        android:hint="Write a cover letter"
        android:gravity="top|start"
        android:inputType="textCapSentences|textMultiLine"
        android:minLines="6"
        android:background="@drawable/bg_input"
        android:padding="14dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/hint"
        android:layout_marginTop="24dp"
        android:layout_width="match_parent"
        android:layout_height="160dp" />

    <Button
        android:id="@+id/submitApplication"
        android:text="Send application"
        android:textAllCaps="false"
        android:textColor="@color/navy"
        android:textStyle="bold"
        android:background="@drawable/bg_pill"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="56dp" />
</LinearLayout>